{
    "extends": "@repo/typescript-config/react-library.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "lib": ["ES2022", "DOM"],
        "jsx": "react-jsx",
        "declaration": true,
        "declarationMap": true,
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
