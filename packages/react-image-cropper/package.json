{
    "name": "@privatetools/react-image-cropper",
    "version": "1.0.0",
    "description": "A privacy-first, lightweight, and fully typed React image cropper. Built for Tailwind CSS, shadcn/ui, and zero-config DX. 100% client-side.",
    "type": "module",
    "private": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint ."
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sikandardevbusiness/privatetools-packages.git"
    },
    "homepage": "https://privatetools.in/tools/image/universal-image-cropper",
    "keywords": [
        "react",
        "react-image-cropper",
        "image-cropper",
        "avatar-cropper",
        "typescript",
        "tailwindcss",
        "shadcn",
        "headless-ui",
        "client-side",
        "privacy-first",
        "canvas",
        "image-manipulation",
        "crop-image",
        "no-server-upload"
    ],
    "author": "PrivateTools <contact@privatetools.in> (https://privatetools.in)",
    "license": "MIT",
    "funding": {
        "type": "individual",
        "url": "https://www.buymeacoffee.com/sikandardevbusiness"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {},
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "@repo/typescript-config": "workspace:*",
        "@types/node": "^22.9.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    }
}
