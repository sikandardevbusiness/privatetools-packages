{
    "$schema": "https://turbo.build/schema.json",
    "concurrency": "20",
    "globalEnv": [],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".next/**", "dist/**"]
        },
        "lint": {
            "dependsOn": ["^build"]
        },
        "check-types": {
            "dependsOn": ["^build"],
            "cache": true
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
